DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novora
DB_USER=root
DB_PASS=

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY_SECONDS=604800

# Email Delivery (Free via Gmail App Password, Brevo, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@novora.com
SMTP_FROM_NAME=Novora

# SMS Gateway (Optional: Twilio or Fast2SMS)
# Note: On Android Emulator, SMS is automatically delivered natively to emulator screen via ADB if no gateway is set!
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
