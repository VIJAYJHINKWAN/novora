# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Backend API URL (Expo prefixes variables with EXPO_PUBLIC_ to expose them to client code)
# For testing on a physical phone over Wi-Fi (replace with your PC's Wi-Fi IPv4 address):
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# For testing on Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
